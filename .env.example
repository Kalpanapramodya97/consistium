# ─────────────────────────────────────────────────────────────────────────────
# Consistium — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alertmanager SMTP credentials ────────────────────────────────────────────
# Generate a Gmail App Password at:
# https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
SMTP_PASSWORD=your_gmail_app_password_here

# ── Backend secrets ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_in_production
MONGODB_URI=mongodb://mongodb:27017/consistium
