{
  "title": "Habit Tracker Overview",
  "tags": ["nginx", "logs"],
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Nginx Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Connections Active",
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nginx_connections_active",
          "legendFormat": "Active Connections",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Application Logs (Consistium)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "queryType": "range",
          "expr": "{compose_service=\"consistium\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
