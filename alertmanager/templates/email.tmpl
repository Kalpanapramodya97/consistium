{{/* =========================================================
     Consistium DevOps — Alertmanager Email Templates
     Uses only Go text/template builtins supported by Alertmanager.
     Ref: https://pkg.go.dev/text/template
     ========================================================= */}}

{{/* ── Helper: severity colour ── */}}
{{ define "severityColor" -}}
  {{- if eq .CommonLabels.severity "critical" }}#ef4444
  {{- else if eq .CommonLabels.severity "warning" }}#f59e0b
  {{- else }}#22c55e{{ end -}}
{{ end }}

{{/* ── Helper: severity emoji ── */}}
{{ define "severityEmoji" -}}
  {{- if eq .Status "resolved" }}✅
  {{- else if eq .CommonLabels.severity "critical" }}🔴
  {{- else if eq .CommonLabels.severity "warning" }}🟡
  {{- else }}🔔{{ end -}}
{{ end }}

{{/* =========================================================
     MAIN DEVOPS ALERT TEMPLATE
     ========================================================= */}}
{{ define "email.devops.html" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Consistium Alert — {{ .CommonLabels.alertname }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0f1117;
      color: #e2e8f0;
      padding: 24px;
    }
    .wrapper { max-width: 680px; margin: 0 auto; }

    .header {
      background: linear-gradient(135deg, #1a1d2e 0%, #16213e 100%);
      border-radius: 12px 12px 0 0;
      padding: 28px 32px;
      border-top: 4px solid {{ template "severityColor" . }};
    }
    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .brand { font-size: 13px; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase; }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      {{ if eq .Status "resolved" }}
        background: rgba(34,197,94,0.2); color: #22c55e; border: 1px solid #22c55e;
      {{ else if eq .CommonLabels.severity "critical" }}
        background: rgba(239,68,68,0.2); color: #ef4444; border: 1px solid #ef4444;
      {{ else }}
        background: rgba(245,158,11,0.2); color: #f59e0b; border: 1px solid #f59e0b;
      {{ end }}
    }
    .header h1 { font-size: 22px; font-weight: 700; color: #f1f5f9; margin-top: 6px; }
    .header .meta { font-size: 12px; color: #94a3b8; margin-top: 6px; }

    .body {
      background: #1e2130;
      padding: 28px 32px;
      border-radius: 0 0 12px 12px;
    }

    .alert-card {
      background: #252840;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 16px;
      border-left: 3px solid {{ template "severityColor" . }};
    }
    .alert-card.resolved { border-left-color: #22c55e; }

    .alert-name { font-size: 16px; font-weight: 700; color: #f1f5f9; margin-bottom: 6px; }
    .alert-desc {
      font-size: 13px;
      color: #94a3b8;
      background: #1a1d2e;
      border-radius: 6px;
      padding: 12px 14px;
      white-space: pre-wrap;
      font-family: "SFMono-Regular", Consolas, monospace;
      line-height: 1.6;
      margin-top: 10px;
    }

    .labels { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .label-chip {
      background: #1a1d2e;
      border: 1px solid #334155;
      border-radius: 4px;
      padding: 3px 9px;
      font-size: 11px;
      color: #94a3b8;
      font-family: monospace;
    }

    .section-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #64748b;
      margin-bottom: 12px;
      padding-bottom: 6px;
      border-bottom: 1px solid #334155;
    }

    .btn-row { text-align: center; margin: 24px 0 0; }
    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff !important;
      text-decoration: none;
      padding: 12px 32px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .footer {
      margin-top: 24px;
      text-align: center;
      color: #475569;
      font-size: 12px;
      line-height: 1.8;
    }
    .footer a { color: #6366f1; text-decoration: none; }
  </style>
</head>
<body>
<div class="wrapper">

  <!-- Header -->
  <div class="header">
    <div class="header-top">
      <span class="brand">◆ Consistium DevOps</span>
      <span class="status-badge">
        {{ if eq .Status "resolved" }}✅ RESOLVED{{ else }}🔔 FIRING{{ end }}
      </span>
    </div>
    <h1>{{ template "severityEmoji" . }} {{ .CommonLabels.alertname }}</h1>
    <div class="meta">
      {{ .Alerts | len }} alert(s){{ if .CommonLabels.job }} &bull; Job: {{ .CommonLabels.job }}{{ end }}{{ if .CommonLabels.instance }} &bull; Instance: {{ .CommonLabels.instance }}{{ end }}
    </div>
  </div>

  <!-- Body -->
  <div class="body">

    <!-- Firing Alerts -->
    {{ if .Alerts.Firing }}
    <div class="section-title">🔔 Firing Alerts ({{ .Alerts.Firing | len }})</div>
    {{ range .Alerts.Firing }}
    <div class="alert-card">
      <div class="alert-name">{{ .Annotations.summary }}</div>
      {{ if .Annotations.description }}
      <div class="alert-desc">{{ .Annotations.description }}</div>
      {{ end }}
      <div class="labels">
        {{ range .Labels.SortedPairs }}
        <span class="label-chip">{{ .Name }}={{ .Value }}</span>
        {{ end }}
      </div>
    </div>
    {{ end }}
    {{ end }}

    <!-- Resolved Alerts -->
    {{ if .Alerts.Resolved }}
    <div class="section-title" style="margin-top:20px; border-bottom-color:#22c55e; color:#22c55e;">✅ Resolved Alerts ({{ .Alerts.Resolved | len }})</div>
    {{ range .Alerts.Resolved }}
    <div class="alert-card resolved">
      <div class="alert-name" style="color:#22c55e;">{{ .Annotations.summary }}</div>
      {{ if .Annotations.description }}
      <div class="alert-desc">{{ .Annotations.description }}</div>
      {{ end }}
      <div class="labels">
        {{ range .Labels.SortedPairs }}
        <span class="label-chip">{{ .Name }}={{ .Value }}</span>
        {{ end }}
      </div>
    </div>
    {{ end }}
    {{ end }}

    <!-- CTA Button -->
    {{ with .CommonAnnotations.dashboard_url }}
    <div class="btn-row">
      <a href="{{ . }}" class="btn">📊 Open Grafana Dashboard</a>
    </div>
    {{ end }}

  </div>

  <!-- Footer -->
  <div class="footer">
    Consistium DevOps Alerting Pipeline &bull; Powered by Prometheus + Alertmanager<br/>
    <a href="http://localhost:9090/alerts">Prometheus</a> &bull;
    <a href="http://localhost:9093">Alertmanager</a> &bull;
    <a href="http://localhost:3001">Grafana</a><br/><br/>
    ◆ Consistium — 1% better every day
  </div>

</div>
</body>
</html>
{{ end }}


{{/* =========================================================
     WATCHDOG HEARTBEAT TEMPLATE
     ========================================================= */}}
{{ define "email.watchdog.html" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    body { font-family: "Segoe UI", Roboto, sans-serif; background: #0f1117; color: #e2e8f0; padding: 24px; }
    .card {
      max-width: 560px;
      margin: 0 auto;
      background: #1e2130;
      border-radius: 12px;
      padding: 36px 32px;
      border-top: 4px solid #22c55e;
      text-align: center;
    }
    h1 { font-size: 26px; color: #22c55e; margin-bottom: 10px; }
    p  { color: #94a3b8; font-size: 14px; line-height: 1.7; }
    .checklist {
      text-align: left;
      background: #252840;
      border-radius: 8px;
      padding: 18px 22px;
      margin: 20px 0;
      list-style: none;
    }
    .checklist li { padding: 5px 0; font-size: 13px; color: #cbd5e1; }
    .checklist li::before { content: "✅  "; }
    .links { margin-top: 16px; }
    .links a { color: #6366f1; text-decoration: none; font-size: 13px; margin: 0 8px; }
    .footer { margin-top: 24px; color: #475569; font-size: 12px; }
  </style>
</head>
<body>
<div class="card">
  <h1>💚 Pipeline Heartbeat</h1>
  <p>Your Consistium alerting pipeline is alive and healthy.<br/>
     This daily email confirms end-to-end connectivity:</p>
  <ul class="checklist">
    <li>Prometheus is scraping and evaluating rules</li>
    <li>Alert rules file is loaded</li>
    <li>Alertmanager received the alert</li>
    <li>Email delivery (SMTP) is working</li>
  </ul>
  <p>If you stop receiving this daily email, investigate the alerting stack immediately.</p>
  <div class="links">
    <a href="http://localhost:9090/alerts">Prometheus Alerts</a>
    <a href="http://localhost:9093">Alertmanager UI</a>
    <a href="http://localhost:3001">Grafana</a>
  </div>
  <div class="footer">◆ Consistium DevOps &bull; 1% better every day</div>
</div>
</body>
</html>
{{ end }}
